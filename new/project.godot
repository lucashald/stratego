; Stratego — Godot 4 project
config_version=5

[application]

config/name="Stratego: New Rules Lab"
run/main_scene="res://scenes/main.tscn"

[display]

window/size/viewport_width=1120
window/size/viewport_height=820
window/size/window_width_override=1120
window/size/window_height_override=820
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.047, 0.067, 1)
